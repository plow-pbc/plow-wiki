{
  "name": "wiki",
  "version": "1",
  "command": "wiki",
  "runtime": {
    "binaries": [
      {
        "name": "wiki",
        "url": {
          "arm64": "https://github.com/plow-pbc/plow-wiki/releases/download/v<ver>/wiki_<ver>_darwin_arm64.tar.gz",
          "x64": "https://github.com/plow-pbc/plow-wiki/releases/download/v<ver>/wiki_<ver>_darwin_amd64.tar.gz"
        },
        "sha256": { "arm64": "<sha256>", "x64": "<sha256>" }
      }
    ]
  },
  "env": { "WIKI_PATH": { "fixed": "${owner_home}/Plow/wiki" } },
  "argv": {
    "read": [["validate"], ["history"]],
    "write": [["init"], ["index"], ["snapshot"]]
  },
  "skill": "skill.md"
}
