{
  "name": "wiki",
  "version": "1",
  "command": "wiki",
  "runtime": {
    "sources": [
      {
        "name": "plow-wiki",
        "git": "https://github.com/plow-pbc/plow-wiki",
        "commit": "<sha>",
        "install": ["uv", "sync", "--frozen"]
      }
    ]
  },
  "env": { "WIKI_PATH": { "fixed": "${owner_home}/Plow/wiki" } },
  "argv": {
    "read": [["validate"], ["history"]],
    "write": [["init"], ["index"], ["snapshot"]]
  },
  "skill": "skill.md"
}
